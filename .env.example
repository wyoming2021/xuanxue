# 复制为 .env.local 并填入你的值。各变量含义见 docs/DEPLOYMENT.md

# ===== 数据库（Supabase，必填）=====
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== 会话签名（必填，≥32位随机字符串）=====
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ===== 站点配置 =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=玄语
NEXT_PUBLIC_SUPPORT_EMAIL=

# ===== 登录验证码邮件（QQ 邮箱 SMTP）=====
QQ_EMAIL_USER=
QQ_EMAIL_AUTH_CODE=

# ===== 支付（虎皮椒，不配则为演示模式）=====
HUPIJAO_APP_ID=
HUPIJAO_APP_SECRET=
HUPIJAO_NOTIFY_URL=
