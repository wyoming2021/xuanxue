# 复制为 .env.local 并填入你的值。各变量含义见 docs/DEPLOYMENT.md

# ===== 数据库（Supabase，必填）=====
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== 会话签名（必填，≥32位随机字符串）=====
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ===== 站点配置 =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=玄语
NEXT_PUBLIC_SUPPORT_EMAIL=

# ===== 登录验证码邮件（QQ 邮箱 SMTP）=====
QQ_EMAIL_USER=
QQ_EMAIL_AUTH_CODE=

# ===== 支付（虎皮椒，不配则为演示模式）=====
HUPIJAO_APP_ID=
HUPIJAO_APP_SECRET=
HUPIJAO_NOTIFY_URL=

# ===== 文章管理（站长发布文章）=====
# 拥有此邮箱的登录用户可以进入 /admin/articles 发布文章
ADMIN_EMAIL=

# ===== AI 自动写文章（可选）=====
# 支持 DeepSeek 等 OpenAI 兼容接口；不配置则 AI 写文章/每日自动更新不可用
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 定时任务密钥（部署脚本自动生成；用于每日自动生成文章的鉴权）
CRON_SECRET=
