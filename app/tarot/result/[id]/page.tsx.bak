"use client";
import { ArrowLeft } from "lucide-react";
import Link from "next/link";
import { useState, useEffect } from "react";

import { getDeviceId } from "@/lib/device";
import { ShareButton } from "@/components/ShareButton";
import { supabase } from "@/lib/supabase";

export default function TarotResultPage({ params }: { params: Promise<{ id: string }> }) {
  const [id, setId] = useState<string>("");
  const [result, setResult] = useState<any>(null);
  const [loading, setLoading] = useState(true);

  const loadResult = async (recordId: string) => {
    try {
      if (supabase && !recordId.startsWith("local-")) {
        const { data } = await supabase
          .from("tarot_records")
          .select("*")
          .eq("id", recordId)
          .single();
        if (data) {
          setResult(data);
          setLoading(false);
          return;
        }
      }
    } catch (e) {
      // ignore error, fallback to localStorage
    }

    // Fallback to localStorage
    const stored = localStorage.getItem(`tarot-${recordId}`);
    if (stored) {
      setResult(JSON.parse(stored));
    }
    setLoading(false);
  };

  useEffect(() => {
    params.then(p => {
      setId(p.id);
      loadResult(p.id);
    });
  }, [params]);

  if (loading) {
    return (
      <div className="flex min-h-screen items-center justify-center">
        <div className="text-[#737373]">加载中...</div>
      </div>
    );
  }

  if (!result) {
    return (
      <div className="flex min-h-screen flex-col items-center justify-center gap-4">
        <p className="text-[#737373]">未找到占卜结果</p>
        <Link href="/tarot" className="text-sm text-indigo-600 hover:underline">返回抽牌</Link>
      </div>
    );
  }

  const cards = result.cards || [];
  const question = result.question || "请给我指引";

  const getOverallReading = () => {
    const uprightCount = cards.filter((c: any) => c.position === "正位").length;
    const reversedCount = cards.length - uprightCount;

    let reading = `本次占卜共抽取${cards.length}张牌，其中正位${uprightCount}张，逆位${reversedCount}张。\n\n`;

    if (cards.length === 3) {
      reading += `过去：${cards[0].name}（${cards[0].position}）- ${cards[0].meaning}\n`;
      reading += `现在：${cards[1].name}（${cards[1].position}）- ${cards[1].meaning}\n`;
      reading += `未来：${cards[2].name}（${cards[2].position}）- ${cards[2].meaning}\n\n`;
      reading += `综合来看，你的情况正在从${cards[0].meaning}转变为${cards[2].meaning}。`;
    } else {
      reading += `整体能量：`;
      if (uprightCount > reversedCount) {
        reading += "正向能量较强，事情发展较为顺利。\n";
      } else if (reversedCount > uprightCount) {
        reading += "需要注意逆位牌的提醒，可能有些挑战需要面对。\n";
      } else {
        reading += "能量平衡，需要根据具体情况灵活应对。\n";
      }
    }

    return reading;
  };

  return (
    <div className="page-transition">
      <div className="border-b border-black/5 bg-white/50 dark:border-white/5 dark:bg-white/[0.02]">
        <div className="mx-auto max-w-3xl px-4 py-12 text-center sm:px-6">
          <Link
            href="/tarot"
            className="mb-6 inline-flex items-center gap-1 text-sm text-[#737373] hover:text-[#1c1917] dark:text-[#78716c] dark:hover:text-[#e7e5e4]"
          >
            <ArrowLeft className="h-4 w-4" /> 重新抽牌
          </Link>
          <h1 className="mb-2 font-serif text-3xl font-bold">🃏 塔罗占卜结果</h1>
          <p className="text-sm text-[#737373]">问题：{question}</p>
        </div>
      </div>

      <div className="mx-auto max-w-3xl px-4 py-12 sm:px-6">
        <div className="space-y-8">
          {/* 牌阵展示 */}
          <div className="grid grid-cols-3 gap-4">
            {cards.map((card: any, i: number) => (
              <div
                key={i}
                className={`rounded-2xl border p-5 text-center ${
                  card.position === "正位"
                    ? "border-indigo-200 bg-indigo-50/50 dark:border-indigo-800 dark:bg-indigo-950/20"
                    : "border-purple-200 bg-purple-50/50 dark:border-purple-800 dark:bg-purple-950/20"
                }`}
              >
                <div className="mb-1 text-xs font-medium text-[#a3a3a3]">
                  {card.positionName || `第${i + 1}张`}
                </div>
                <div className="mb-2 text-4xl">{card.image || "🃏"}</div>
                <div className="mb-1 font-serif font-bold">{card.name}</div>
                <div className={`mb-2 text-xs font-medium ${card.position === "正位" ? "text-indigo-600" : "text-purple-600"}`}>
                  {card.position}
                </div>
                <div className="flex flex-wrap justify-center gap-1">
                  {(card.keywords || []).slice(0, 2).map((k: string, j: number) => (
                    <span key={j} className="rounded-full bg-white px-2 py-0.5 text-[10px] text-[#737373] shadow-sm dark:bg-white/10">
                      {k}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>

          {/* 详细解读 */}
          {cards.map((card: any, i: number) => (
            <div key={i} className="rounded-2xl border border-black/5 bg-white p-5 shadow-sm dark:border-white/5 dark:bg-white/[0.03]">
              <div className="mb-3 flex items-center gap-3">
                <span className="text-3xl">{card.image || "🃏"}</span>
                <div>
                  <div className="font-serif font-bold">{card.positionName || `第${i + 1}张`} · {card.name}</div>
|                  <div className="flex gap-2 text-xs">|                    <span className={card.position === "正位" ? "font-medium text-indigo-600" : "font-medium text-purple-600"}>|                      {card.position}|                    </span>|                  </div|
                    </span>
                </div>
              </div>
              <p className="text-sm leading-relaxed text-[#57534e] dark:text-[#a8a29e]">
                {card.position === "正位" ? card.uprightReading : card.reversedReading}
              </p>
            </div>
          ))}

          {/* 综合解读 */}
          <div className="rounded-2xl border border-indigo-200 bg-indigo-50/50 p-6 dark:border-indigo-800 dark:bg-indigo-950/20">
            <h3 className="mb-4 font-serif text-lg font-bold text-indigo-700 dark:text-indigo-300">
              🌟 综合解读
            </h3>
            <div className="whitespace-pre-line text-sm leading-relaxed text-[#57534e] dark:text-[#a8a29e]">
              {getOverallReading()}
            </div>
          </div>

          {/* 分享按钮 */}
          <div className="flex justify-center">
            <ShareButton
              title="塔罗占卜结果"
              description={`问题：${question} - ${cards.map((c: any) => c.name).join("、")}`}
            />
          </div>
        </div>
      </div>
    </div>
  );
}